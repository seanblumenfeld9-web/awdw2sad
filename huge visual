-- 7. Animated Popup Notification Function
local function showVisualPopup(actionText, petName, variant)
	local banner = Instance.new("Frame")
	banner.Size = UDim2.new(0, 340, 0, 60)
	banner.Position = UDim2.new(0.5, -170, 0, -70)
	banner.BackgroundColor3 = Color3.fromRGB(28, 30, 40)
	banner.BorderSizePixel = 0
	banner.Parent = screenGui

	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 10)
	bCorner.Parent = banner

	local bStroke = Instance.new("UIStroke")
	bStroke.Color = variantColors[variant]
	bStroke.Thickness = 2
	bStroke.Parent = banner

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -20, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = "✨ " .. actionText .. ": [" .. variant .. "] " .. petName .. "!"
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.FredokaOne
	label.TextSize = 16
	label.TextWrapped = true
	label.Parent = banner

	-- Slide Down Animation
	TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, -170, 0, 25)
	}):Play()

	task.delay(2.5, function()
		local slideOut = TweenService:Create(banner, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0.5, -170, 0, -70)
		})
		slideOut:Play()
		slideOut.Completed:Connect(function()
			banner:Destroy()
		end)
	end)
end

-- 8. Button Click Connections
spawnBtn.MouseButton1Click:Connect(function()
	local petName = petInput.Text ~= "" and petInput.Text or "Huge Cat"
	local variant = variants[currentVariantIndex]
	showVisualPopup("Spawned", petName, variant)
end)

dupeBtn.MouseButton1Click:Connect(function()
	local petName = petInput.Text ~= "" and petInput.Text or "Huge Cat"
	local variant = variants[currentVariantIndex]
	showVisualPopup("Duplicated (x2)", petName, variant)
end)
