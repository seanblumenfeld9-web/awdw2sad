-- 5. Variant Selector Button (Cycles Normal -> Golden -> Rainbow -> Shiny)
local variants = {"Normal", "Golden", "Rainbow", "Shiny"}
local variantColors = {
	Normal = Color3.fromRGB(70, 140, 255),
	Golden = Color3.fromRGB(255, 195, 35),
	Rainbow = Color3.fromRGB(235, 75, 255),
	Shiny = Color3.fromRGB(65, 235, 190)
}
local currentVariantIndex = 1

local variantBtn = Instance.new("TextButton")
variantBtn.Size = UDim2.new(0.86, 0, 0, 38)
variantBtn.Position = UDim2.new(0.07, 0, 0.42, 0)
variantBtn.BackgroundColor3 = variantColors.Normal
variantBtn.Text = "Variant: Normal (Click to Change)"
variantBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
variantBtn.Font = Enum.Font.GothamBold
variantBtn.TextSize = 14
variantBtn.Parent = mainFrame

local variantCorner = Instance.new("UICorner")
variantCorner.CornerRadius = UDim.new(0, 8)
variantCorner.Parent = variantBtn

variantBtn.MouseButton1Click:Connect(function()
	currentVariantIndex = (currentVariantIndex % #variants) + 1
	local selected = variants[currentVariantIndex]
	variantBtn.Text = "Variant: " .. selected .. " (Click to Change)"
	TweenService:Create(variantBtn, TweenInfo.new(0.2), {
		BackgroundColor3 = variantColors[selected]
	}):Play()
end)

